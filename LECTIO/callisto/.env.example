# Copy to .env and fill in. .env is gitignored. Never paste real keys anywhere else.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
MODEL_FAST=anthropic/claude-haiku-5-5
MODEL_STRONG=anthropic/claude-sonnet-5-5
# SEC asks for a name + contact in the User-Agent of every request
SEC_USER_AGENT=
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
# Massive market data (formerly Polygon.io). Leave empty: market, second-source and news parts say "unavailable".
MASSIVE_API_KEY=
# Research desk switches: multi (default) or single (old one-agent path); enforce | advisory | off
EUROPA_PIPELINE=multi
EUROPA_SKEPTIC=enforce
MODEL_ROUTER=
MODEL_SKEPTIC=openai/gpt-5.4-mini
