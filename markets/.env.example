# Copy to .env.local and fill in (or link .env.local to the project's root .env, which has the same names).
# .env.local is git-ignored; never commit real values.

# Market data (charts, news, the IPO calendar)
MASSIVE_API_KEY=

# SEC EDGAR asks every client for a name and a contact email (free text, not a key)
SEC_USER_AGENT=

# PRISM tracing of the desk's data calls
PRISMTRACE_API_KEY=
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# Where the desk finds the rest of the project (these are the defaults)
BACKEND_ORIGIN=http://127.0.0.1:8130
NEXT_PUBLIC_EUROPA_URL=http://127.0.0.1:3000
