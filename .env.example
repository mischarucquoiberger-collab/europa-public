# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Model provider (Nicrron, OpenAI-compatible)
NICRRON_API_KEY=

# PRISM (ingest-scoped key, starts with pt-sk-; project id is a UUID from Settings > Project)
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=

# Privacy (these are the defaults)
PRISM_HIDE_SYSTEM_PROMPT=true
PRISM_MAX_CHARS=500

# Massive market data (optional: prices and peers)
MASSIVE_API_KEY=

# SEC EDGAR requires a name and a contact email on every request
SEC_USER_AGENT=
